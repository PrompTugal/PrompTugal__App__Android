<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Only to tell the user plainly when the device is offline; no network data is read. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Package visibility (API 30+): lets the app find a browser that supports Custom Tabs. Not a permission. -->
    <queries>
        <intent>
            <action android:name="android.support.customtabs.action.CustomTabsService" />
        </intent>
    </queries>

    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher_rm"
        android:roundIcon="@mipmap/ic_launcher_rm"
        android:localeConfig="@xml/locales_config"
        tools:targetApi="33"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:usesCleartextTraffic="false"
        android:supportsRtl="true"
        android:theme="@style/Theme.RiskMandate">
        <!-- Managed configuration (M2): start_url and device_label, set by the organisation's EMM. -->
        <meta-data
            android:name="android.content.APP_RESTRICTIONS"
            android:resource="@xml/app_restrictions" />
        <!-- Dropped on purpose: the merged manifest would add this exported receiver (androidx.profileinstaller,
             from Compose) so adb can trigger baseline-profile installation. Removing it keeps the app's
             reach equal to its mandate (docs: features/mandate); baseline-profile installation is dropped. -->
        <receiver
            android:name="androidx.profileinstaller.ProfileInstallReceiver"
            tools:node="remove"
            tools:ignore="MissingClass" />
        <!-- LiteRT-LM's GPU backend (llm/) loads the vendor OpenCL library; optional, CPU is the fallback. -->
        <uses-native-library android:name="libOpenCL.so" android:required="false" />
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>
</manifest>
