<?xml version="1.0" encoding="utf-8"?>
<!-- Android 11 and older (fullBackupContent). allowBackup is already false; this excludes every domain by name as well. -->
<full-backup-content>
    <exclude domain="root" />
    <exclude domain="file" />
    <exclude domain="database" />
    <exclude domain="sharedpref" />
    <exclude domain="external" />
</full-backup-content>
